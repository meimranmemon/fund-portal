# ─────────────────────────────────────────────
# REQUIRED: Copy this file to .env for local dev
# On Vercel: add these in Project → Settings → Environment Variables
# ─────────────────────────────────────────────

# Supabase PostgreSQL connection URL
# Get from: https://supabase.com/dashboard → Project → Settings → Database
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Firebase Service Account JSON (as a single-line JSON string)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON file content as one line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"fund-investor-portal",...}

# Secret key for scheduled (cron) jobs
# Any random string — keep it secret
CRON_SECRET=change-this-to-a-random-secret

# (Optional) Force SSL off for local postgres
# DB_SSL=false
